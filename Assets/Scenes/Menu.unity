  loadingSceneName: LoadingScene
  loadingTips:
  - "\"\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 W/A/S/D \u0438\u043B\u0438
    \u0441\u0442\u0438\u043A\u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430
    \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0434\u0440\u043E\u043D\u0430\""
  - "\"\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u0431\u043E\u043D\u0443\u0441\u044B
    \u0434\u043B\u044F \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043E\u0447\u043A\u043E\u0432!\""
  - "\"\u0418\u0437\u0431\u0435\u0433\u0430\u0439 \u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0438\u0439
    - \u043E\u043D\u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044E\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u044E\""
  - "\"\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439 \u043F\u0440\u0430\u0432\u0443\u044E
    \u043A\u043D\u043E\u043F\u043A\u0443 \u043C\u044B\u0448\u0438 \u0434\u043B\u044F
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u043A\u0430\u043C\u0435\u0440\u043E\u0439\""
  - "\"\u041F\u0440\u043E\u0431\u0435\u043B - \u043F\u043E\u0434\u044A\u0451\u043C,
    Ctrl - \u0441\u043F\u0443\u0441\u043A\""
