  m_Script: {fileID: 11500000, guid: f4dac6c73c2f55a419e55ff8973e9203, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tutorialPanel: {fileID: 1712660967}
  titleText: {fileID: 718113332}
  descriptionText: {fileID: 1732562783}
  illustrationImage: {fileID: 1560836971}
  nextButton: {fileID: 134178328}
  backButton: {fileID: 5960045}
  skipButton: {fileID: 2077349244}
  tutorialPages:
  - title: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
    description: "\u0414\u043B\u044F \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0434\u0440\u043E\u043D\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      WASD \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.\n\nQE
      \u0438 \u043C\u044B\u0448\u044C \u0434\u043B\u044F \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F.\n\nSpace
      and ctrl \u0434\u043B\u044F \u043F\u043E\u0434\u043D\u044F\u0442\u0438\u044F/\u0441\u043F\u0443\u0441\u043A\u0430.\n\n\u0414\u043B\u044F
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u0434\u0440\u043E\u043D\u043E\u043C
      \u0432 \u0448\u043B\u0435\u043C\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u044B HTC VIVE
      Pro."
    illustration: {fileID: 21300000, guid: 76dc0abb2ebb44c9a9bd39266f0b3c91, type: 3}
  - title: "\u0426\u0435\u043B\u044C"
    description: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044E
      \u0441\u0432\u043E\u0435\u0433\u043E \u0434\u0440\u043E\u043D\u0430 \u0438
      \u0432\u044B\u0431\u0435\u0440\u0438 \u0441\u043B\u043E\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.\n\n\u041D\u0435
      \u0437\u0430\u0431\u0443\u0434\u044C \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u043E\u043B\u0435\u0442\u0435\u0442\u044C \u0432\u0441\u0435
      \u043F\u0440\u0438\u043F\u044F\u0442\u0441\u0432\u0438\u044F \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0441\u0447\u0435\u0442 \u0431\u0443\u0434\u0435\u0442
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D!\n\n\u0421\u0447\u0435\u0442
      = \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u043F\u0440\u0438\u043F\u044F\u0442\u0441\u0432\u0438\u044F
      + \u043E\u0441\u0442\u0430\u0432\u0448\u0435\u0435\u0441\u044F \u0432\u0440\u0435\u043C\u044F
      \u0431\u0430\u0442\u0430\u0440\u0435\u0438 + \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F."
    illustration: {fileID: 21300000, guid: 3b2e62babc5249f42921c2cd027852cd, type: 3}
  nextSceneName: drone1
  previousSceneName: SlotSelectionScene
  showOnlyOnce: 1
